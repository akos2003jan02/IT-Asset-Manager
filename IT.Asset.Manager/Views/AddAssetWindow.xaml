<Window x:Class="IT.Asset.Manager.Views.AddAssetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Device"
        Height="780"
        Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#252526">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText"
                   Text="Add New Device"
                   Foreground="White"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <TextBlock Text="Inventory ID"
                           Foreground="#CCCCCC"/>

                <TextBox x:Name="InventoryIdBox"
                         Margin="0,5,0,15"
                         IsReadOnly="True"
                         Background="#333337"
                         Foreground="#AAAAAA"/>


                <TextBlock Text="Manufacturer"
                           Foreground="#CCCCCC"/>

                <TextBox x:Name="ManufacturerBox"
                         Margin="0,5,0,15"/>


                <TextBlock Text="Model"
                           Foreground="#CCCCCC"/>

                <TextBox x:Name="ModelBox"
                         Margin="0,5,0,15"/>


                <TextBlock Text="Serial Number"
                           Foreground="#CCCCCC"/>

                <TextBox x:Name="SerialBox"
                         Margin="0,5,0,15"/>


                <TextBlock Text="Status"
                           Foreground="#CCCCCC"/>

                <ComboBox x:Name="StatusBox"
                          Margin="0,5,0,15"
                          SelectedIndex="0">

                    <ComboBoxItem>In Stock</ComboBoxItem>
                    <ComboBoxItem>Issued</ComboBoxItem>
                    <ComboBoxItem>Service</ComboBoxItem>

                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">

                            <Setter Property="Background"
                                    Value="#2D2D30"/>

                            <Setter Property="Foreground"
                                    Value="White"/>

                            <Setter Property="Padding"
                                    Value="10,6"/>

                            <Style.Triggers>

                                <Trigger Property="IsMouseOver"
                                         Value="True">

                                    <Setter Property="Background"
                                            Value="#3A3A3A"/>

                                    <Setter Property="Foreground"
                                            Value="White"/>

                                </Trigger>

                                <Trigger Property="IsSelected"
                                         Value="True">

                                    <Setter Property="Background"
                                            Value="#007ACC"/>

                                    <Setter Property="Foreground"
                                            Value="White"/>

                                </Trigger>

                            </Style.Triggers>

                        </Style>
                    </ComboBox.ItemContainerStyle>

                </ComboBox>


                <TextBlock Text="Purchase Date"
                           Foreground="#CCCCCC"/>

                <DatePicker x:Name="PurchaseDatePicker"
                            Margin="0,5,0,15"/>


                <TextBlock Text="Assigned User"
                           Foreground="#CCCCCC"/>

                <TextBox x:Name="AssignedUserBox"
                         Margin="0,5,0,15"/>


                <TextBlock Text="Location"
                           Foreground="#CCCCCC"/>

                <TextBox x:Name="LocationBox"
                         Margin="0,5,0,15"/>


                <TextBlock Text="Department"
                           Foreground="#CCCCCC"/>

                <TextBox x:Name="DepartmentBox"
                         Margin="0,5,0,15"/>


                <TextBlock Text="Notes"
                           Foreground="#CCCCCC"/>

                <TextBox x:Name="NotesBox"
                         Margin="0,5,0,15"
                         Height="80"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"/>

            </StackPanel>

        </ScrollViewer>

        <Button Grid.Row="2"
                Content="Save"
                Height="40"
                Background="#007ACC"
                Foreground="White"
                BorderThickness="0"
                FontSize="14"
                FontWeight="SemiBold"
                Click="Save_Click"/>

    </Grid>

</Window>