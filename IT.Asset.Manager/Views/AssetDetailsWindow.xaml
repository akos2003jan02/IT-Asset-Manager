<Window x:Class="IT.Asset.Manager.Views.AssetDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Asset Details"
        Width="850"
        Height="700"
        WindowStartupLocation="CenterOwner"
        Background="#252526">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel>

            <TextBlock Text="Asset Details"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold"/>

            <TextBlock x:Name="InventoryIdText"
                       Foreground="#4FC3F7"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,5,0,0"/>

        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Margin="0,25,0,20">

            <StackPanel>

                <!-- Basic Information -->
                <TextBlock Text="Basic Information"
                           Foreground="White"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12"/>

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Inventory ID"
                               Foreground="#999999"
                               Margin="0,0,0,12"/>

                    <TextBlock x:Name="InventoryIdValue"
                               Grid.Row="0"
                               Grid.Column="1"
                               Foreground="White"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"/>


                    <TextBlock Grid.Row="1"
                               Text="Manufacturer"
                               Foreground="#999999"
                               Margin="0,0,0,12"/>

                    <TextBlock x:Name="ManufacturerText"
                               Grid.Row="1"
                               Grid.Column="1"
                               Foreground="White"
                               Margin="0,0,0,12"/>


                    <TextBlock Grid.Row="2"
                               Text="Model"
                               Foreground="#999999"
                               Margin="0,0,0,12"/>

                    <TextBlock x:Name="ModelText"
                               Grid.Row="2"
                               Grid.Column="1"
                               Foreground="White"
                               Margin="0,0,0,12"/>


                    <TextBlock Grid.Row="3"
                               Text="Serial Number"
                               Foreground="#999999"
                               Margin="0,0,0,12"/>

                    <TextBlock x:Name="SerialText"
                               Grid.Row="3"
                               Grid.Column="1"
                               Foreground="White"
                               Margin="0,0,0,12"/>


                    <TextBlock Grid.Row="4"
                               Text="Status"
                               Foreground="#999999"
                               Margin="0,0,0,12"/>

                    <TextBlock x:Name="StatusText"
                               Grid.Row="4"
                               Grid.Column="1"
                               Foreground="White"
                               Margin="0,0,0,12"/>


                    <TextBlock Grid.Row="5"
                               Text="Assigned User"
                               Foreground="#999999"
                               Margin="0,0,0,12"/>

                    <TextBlock x:Name="AssignedUserText"
                               Grid.Row="5"
                               Grid.Column="1"
                               Foreground="White"
                               Margin="0,0,0,12"/>


                    <TextBlock Grid.Row="6"
                               Text="Location"
                               Foreground="#999999"
                               Margin="0,0,0,12"/>

                    <TextBlock x:Name="LocationText"
                               Grid.Row="6"
                               Grid.Column="1"
                               Foreground="White"
                               Margin="0,0,0,12"/>


                    <TextBlock Grid.Row="7"
                               Text="Department"
                               Foreground="#999999"
                               Margin="0,0,0,12"/>

                    <TextBlock x:Name="DepartmentText"
                               Grid.Row="7"
                               Grid.Column="1"
                               Foreground="White"
                               Margin="0,0,0,12"/>


                    <TextBlock Grid.Row="8"
                               Text="Purchase Date"
                               Foreground="#999999"
                               Margin="0,0,0,12"/>

                    <TextBlock x:Name="PurchaseDateText"
                               Grid.Row="8"
                               Grid.Column="1"
                               Foreground="White"
                               Margin="0,0,0,12"/>

                </Grid>


                <!-- Notes -->
                <TextBlock Text="Notes"
                           Foreground="White"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Margin="0,15,0,8"/>

                <Border Background="#1E1E1E"
                        CornerRadius="5"
                        Padding="12"
                        Margin="0,0,0,20">

                    <TextBlock x:Name="NotesText"
                               Foreground="#CCCCCC"
                               TextWrapping="Wrap"/>

                </Border>


                <!-- History -->
                <TextBlock Text="History"
                           Foreground="White"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <Border Background="#1E1E1E"
                        CornerRadius="5"
                        Padding="5">

                    <DataGrid x:Name="HistoryGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              Height="220"
                              Background="#1E1E1E"
                              Foreground="White"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal">

                        <DataGrid.Resources>

                            <Style TargetType="DataGridCell">
                                <Setter Property="Background"
                                        Value="#1E1E1E"/>

                                <Setter Property="Foreground"
                                        Value="White"/>

                                <Setter Property="Padding"
                                        Value="7,5"/>

                                <Style.Triggers>

                                    <Trigger Property="IsSelected"
                                             Value="True">

                                        <Setter Property="Background"
                                                Value="#007ACC"/>

                                        <Setter Property="Foreground"
                                                Value="White"/>

                                    </Trigger>

                                </Style.Triggers>

                            </Style>

                            <Style TargetType="DataGridRow">

                                <Setter Property="Background"
                                        Value="#1E1E1E"/>

                                <Setter Property="Foreground"
                                        Value="White"/>

                            </Style>

                            <Style TargetType="DataGridColumnHeader">

                                <Setter Property="Background"
                                        Value="#333337"/>

                                <Setter Property="Foreground"
                                        Value="#CCCCCC"/>

                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>

                                <Setter Property="Padding"
                                        Value="7,6"/>

                            </Style>

                        </DataGrid.Resources>

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Date"
                                                Binding="{Binding Timestamp, StringFormat={}{0:yyyy.MM.dd HH:mm}}"
                                                Width="145"/>

                            <DataGridTextColumn Header="Action"
                                                Binding="{Binding Action}"
                                                Width="180"/>

                            <DataGridTextColumn Header="Details"
                                                Binding="{Binding Details}"
                                                Width="*"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Border>

            </StackPanel>

        </ScrollViewer>


        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="QR Code"
                    Width="100"
                    Height="38"
                    Margin="0,0,10,0"
                    Click="QrCode_Click"/>

            <Button Content="Edit Device"
                    Width="110"
                    Height="38"
                    Margin="0,0,10,0"
                    Background="#007ACC"
                    Foreground="White"
                    BorderThickness="0"
                    Click="Edit_Click"/>

            <Button Content="Close"
                    Width="100"
                    Height="38"
                    Click="Close_Click"/>

        </StackPanel>

    </Grid>

</Window>