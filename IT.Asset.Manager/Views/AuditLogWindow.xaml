<Window x:Class="IT.Asset.Manager.Views.AuditLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audit Log"
        Width="1000"
        Height="700"
        MinWidth="800"
        MinHeight="550"
        Background="#252526"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0">

            <TextBlock Text="Audit Log"
                       Foreground="White"
                       FontSize="26"
                       FontWeight="Bold"/>

            <TextBlock Text="Az eszközökön végrehajtott műveletek története"
                       Foreground="#999999"
                       FontSize="13"
                       Margin="0,5,0,0"/>

        </StackPanel>

        <!-- FILTERS -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Height="35"
                     Padding="10,5"
                     FontSize="13"
                     Background="#2D2D30"
                     Foreground="White"
                     BorderBrush="#444444"
                     Text="{Binding SearchText,
                                    UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Keresés gyártó, modell, serial vagy részletek alapján"/>

            <ComboBox Grid.Column="1"
                      Height="35"
                      Margin="10,0,0,0"
                      Padding="8,5"
                      Background="#2D2D30"
                      Foreground="White"
                      BorderBrush="#444444"
                      ItemsSource="{Binding Actions}"
                      SelectedItem="{Binding SelectedAction}">

                <ComboBox.ItemContainerStyle>

                    <Style TargetType="ComboBoxItem">

                        <Setter Property="Background"
                                Value="#2D2D30"/>

                        <Setter Property="Foreground"
                                Value="White"/>

                        <Setter Property="Padding"
                                Value="10,6"/>

                        <Style.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="#3A3A3A"/>

                                <Setter Property="Foreground"
                                        Value="White"/>

                            </Trigger>

                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="#007ACC"/>

                                <Setter Property="Foreground"
                                        Value="White"/>

                            </Trigger>

                        </Style.Triggers>

                    </Style>

                </ComboBox.ItemContainerStyle>

            </ComboBox>

        </Grid>

        <!-- HISTORY -->
        <Border Grid.Row="4"
                Background="#1E1E1E"
                CornerRadius="6"
                Padding="15">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <ItemsControl ItemsSource="{Binding History}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border Background="#252526"
                                    CornerRadius="5"
                                    Padding="15"
                                    Margin="0,0,0,10">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- DATE -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Timestamp,
                                               StringFormat={}{0:yyyy.MM.dd HH:mm}}"
                                               Foreground="#888888"
                                               VerticalAlignment="Top"/>

                                    <!-- ASSET -->
                                    <StackPanel Grid.Column="1">

                                        <TextBlock Text="{Binding Action}"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"/>

                                        <TextBlock Text="{Binding Model}"
                                                   Foreground="#AAAAAA"
                                                   FontSize="12"
                                                   Margin="0,5,0,0"/>

                                        <TextBlock Text="{Binding Manufacturer}"
                                                   Foreground="#777777"
                                                   FontSize="11"/>

                                        <TextBlock Text="{Binding SerialNumber,
                                                   StringFormat=Serial: {0}}"
                                                   Foreground="#777777"
                                                   FontSize="11"/>

                                    </StackPanel>

                                    <!-- DETAILS -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Details}"
                                               Foreground="#BBBBBB"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Top"
                                               Margin="15,0,15,0"/>

                                    <!-- RESTORE -->
                                    <Button Grid.Column="3"
                                            Content="Restore"
                                            Width="90"
                                            Height="32"
                                            Background="#007ACC"
                                            Foreground="White"
                                            BorderThickness="0"
                                            VerticalAlignment="Top"
                                            Command="{Binding DataContext.RestoreCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">

                                        <Button.Style>

                                            <Style TargetType="Button">

                                                <Setter Property="Visibility"
                                                        Value="Collapsed"/>

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding Action}"
                                                                 Value="Deleted">

                                                        <Setter Property="Visibility"
                                                                Value="Visible"/>

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>

                                        </Button.Style>

                                    </Button>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

        </Border>

    </Grid>

</Window>