<Window x:Class="IT.Asset.Manager.Views.BulkAssignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assign User"
        Width="450"
        Height="280"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#252526">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Assign User"
                   Foreground="White"
                   FontSize="22"
                   FontWeight="Bold"/>

        <TextBlock Grid.Row="2"
                   Text="Felhasználó:"
                   Foreground="#CCCCCC"
                   Margin="0,0,0,8"/>

        <TextBox x:Name="UserBox"
                 Grid.Row="2"
                 Margin="0,25,0,0"
                 Height="35"
                 Padding="8,5"/>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Cancel"
                    Width="90"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="Cancel_Click"/>

            <Button Content="Save"
                    Width="90"
                    Height="35"
                    Background="#007ACC"
                    Foreground="White"
                    BorderThickness="0"
                    Click="Save_Click"/>

        </StackPanel>

    </Grid>
</Window>