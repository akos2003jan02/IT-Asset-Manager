<Window x:Class="IT.Asset.Manager.Views.QrCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory QR Code"
        Width="450"
        Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#252526">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Inventory QR Code"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold"/>

            <TextBlock x:Name="InventoryIdText"
                       Foreground="#4FC3F7"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                Width="280"
                Height="280"
                Padding="15"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Image x:Name="QrImage"
                   Stretch="Uniform"/>

        </Border>

        <StackPanel Grid.Row="2"
                    Margin="0,10,0,20"
                    HorizontalAlignment="Center">

            <TextBlock x:Name="DeviceText"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="SerialText"
                       Foreground="#AAAAAA"
                       Margin="0,5,0,0"
                       HorizontalAlignment="Center"/>

        </StackPanel>

        <StackPanel Grid.Row="3"
            Orientation="Horizontal"
            HorizontalAlignment="Center">

            <Button Content="Close"
            Width="100"
            Height="38"
            Margin="0,0,10,0"
            Click="Close_Click"/>

            <Button Content="Save QR"
            Width="100"
            Height="38"
            Margin="0,0,10,0"
            Click="Save_Click"/>

            <Button Content="Print Label"
            Width="110"
            Height="38"
            Background="#007ACC"
            Foreground="White"
            BorderThickness="0"
            Click="PrintLabel_Click"/>

        </StackPanel>

    </Grid>

</Window>