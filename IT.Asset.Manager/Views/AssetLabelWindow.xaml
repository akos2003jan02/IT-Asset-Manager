<Window x:Class="IT.Asset.Manager.Views.AssetLabelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Asset Label"
        Width="500"
        Height="450"
        WindowStartupLocation="CenterOwner"
        Background="#252526">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Inventory Label"
                   Foreground="White"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- Label preview -->
        <Border Grid.Row="1"
                Width="265"
                Height="151"
                Background="White"
                BorderBrush="#AAAAAA"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid Margin="8">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- QR -->
                <Image x:Name="QrImage"
                       Grid.Row="0"
                       Grid.RowSpan="3"
                       Grid.Column="0"
                       Width="95"
                       Height="95"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Stretch="Uniform"/>

                <!-- Inventory ID -->
                <TextBlock x:Name="InventoryIdText"
                           Grid.Row="0"
                           Grid.Column="1"
                           Foreground="Black"
                           FontSize="15"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Margin="5,2,0,3"/>

                <!-- Device -->
                <TextBlock x:Name="DeviceText"
                           Grid.Row="1"
                           Grid.Column="1"
                           Foreground="Black"
                           FontSize="10"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="5,0,0,0"/>

                <!-- Details -->
                <StackPanel Grid.Row="2"
                            Grid.Column="1"
                            Margin="5,3,0,0">

                    <TextBlock x:Name="SerialText"
                               Foreground="#333333"
                               FontSize="8"
                               TextWrapping="Wrap"/>

                    <TextBlock x:Name="DepartmentText"
                               Foreground="#333333"
                               FontSize="8"
                               TextWrapping="Wrap"/>

                    <TextBlock x:Name="LocationText"
                               Foreground="#333333"
                               FontSize="8"
                               TextWrapping="Wrap"/>

                </StackPanel>

            </Grid>

        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="Close"
                    Width="90"
                    Height="38"
                    Margin="0,0,10,0"
                    Click="Close_Click"/>

            <Button Content="Print"
                    Width="100"
                    Height="38"
                    Background="#007ACC"
                    Foreground="White"
                    BorderThickness="0"
                    Click="Print_Click"/>

        </StackPanel>

    </Grid>

</Window>