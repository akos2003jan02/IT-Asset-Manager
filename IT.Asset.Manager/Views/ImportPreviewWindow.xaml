<Window x:Class="IT.Asset.Manager.Views.ImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Excel Import Preview"
        Width="1000"
        Height="650"
        Background="#252526"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->

        <StackPanel>

            <TextBlock Text="Excel Import Preview"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold"/>

            <TextBlock Text="Ellenőrizd az adatokat importálás előtt."
                       Foreground="#999999"
                       Margin="0,5,0,0"/>

        </StackPanel>


        <!-- SUMMARY -->

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,20,0,15">

            <Border Background="#1E1E1E"
                    CornerRadius="5"
                    Padding="15"
                    Margin="0,0,10,0">

                <StackPanel>

                    <TextBlock Text="Összes sor"
                               Foreground="#999999"/>

                    <TextBlock x:Name="TotalText"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"/>

                </StackPanel>

            </Border>

            <Border Background="#1E1E1E"
                    CornerRadius="5"
                    Padding="15"
                    Margin="0,0,10,0">

                <StackPanel>

                    <TextBlock Text="Importálható"
                               Foreground="#999999"/>

                    <TextBlock x:Name="ReadyText"
                               Foreground="#4CAF50"
                               FontSize="20"
                               FontWeight="Bold"/>

                </StackPanel>

            </Border>

            <Border Background="#1E1E1E"
                    CornerRadius="5"
                    Padding="15"
                    Margin="0,0,10,0">

                <StackPanel>

                    <TextBlock Text="Duplikált"
                               Foreground="#999999"/>

                    <TextBlock x:Name="DuplicateText"
                               Foreground="#FFB000"
                               FontSize="20"
                               FontWeight="Bold"/>

                </StackPanel>

            </Border>

            <Border Background="#1E1E1E"
                    CornerRadius="5"
                    Padding="15">

                <StackPanel>

                    <TextBlock Text="Hibás"
                               Foreground="#999999"/>

                    <TextBlock x:Name="ErrorText"
                               Foreground="#FF5555"
                               FontSize="20"
                               FontWeight="Bold"/>

                </StackPanel>

            </Border>

        </StackPanel>


        <!-- TABLE -->

        <Border Grid.Row="2"
                Background="#1E1E1E"
                CornerRadius="6"
                Padding="10">

            <DataGrid x:Name="PreviewGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      Background="#1E1E1E"
                      Foreground="White"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal">

                <DataGrid.Resources>

                    <Style TargetType="DataGridCell">

                        <Setter Property="Background"
                                Value="#1E1E1E"/>

                        <Setter Property="Foreground"
                                Value="White"/>

                        <Setter Property="Padding"
                                Value="7,5"/>

                        <Style.Triggers>

                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="#007ACC"/>

                                <Setter Property="Foreground"
                                        Value="White"/>

                            </Trigger>

                        </Style.Triggers>

                    </Style>

                    <Style TargetType="DataGridColumnHeader">

                        <Setter Property="Background"
                                Value="#333337"/>

                        <Setter Property="Foreground"
                                Value="#CCCCCC"/>

                        <Setter Property="FontWeight"
                                Value="SemiBold"/>

                        <Setter Property="Padding"
                                Value="7,6"/>

                    </Style>

                </DataGrid.Resources>

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Excel Row"
                                        Binding="{Binding RowNumber}"
                                        Width="70"/>

                    <DataGridTextColumn Header="Manufacturer"
                                        Binding="{Binding Manufacturer}"
                                        Width="130"/>

                    <DataGridTextColumn Header="Model"
                                        Binding="{Binding Model}"
                                        Width="150"/>

                    <DataGridTextColumn Header="Serial"
                                        Binding="{Binding SerialNumber}"
                                        Width="150"/>

                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Result"
                                        Binding="{Binding Result}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Message"
                                        Binding="{Binding Message}"
                                        Width="*"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>


        <!-- BUTTONS -->

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Content="Cancel"
                    Width="100"
                    Height="38"
                    Margin="0,0,10,0"
                    Click="Cancel_Click"/>

            <Button Content="Import"
                    Width="120"
                    Height="38"
                    Background="#007ACC"
                    Foreground="White"
                    BorderThickness="0"
                    Click="Import_Click"/>

        </StackPanel>

    </Grid>

</Window>