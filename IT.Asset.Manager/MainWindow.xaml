<Window x:Class="IT.Asset.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IT Asset Manager"
        Width="1200"
        Height="750"
        MinWidth="1000"
        MinHeight="650"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- ComboBox items -->
        <Style x:Key="DarkComboBoxItemStyle"
               TargetType="ComboBoxItem">
            <Setter Property="Background"
                    Value="#2D2D30"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="Padding"
                    Value="10,6"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="#3A3A3A"/>
                    <Setter Property="Foreground"
                            Value="White"/>
                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">
                    <Setter Property="Background"
                            Value="#007ACC"/>
                    <Setter Property="Foreground"
                            Value="White"/>
                </Trigger>

            </Style.Triggers>
        </Style>

        <!-- Warning severity -->
        <Style x:Key="WarningBadgeStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#6B5B00"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding Severity}"
                             Value="Critical">
                    <Setter Property="Background"
                            Value="#7A1F1F"/>
                </DataTrigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========================= -->
        <!-- SIDEBAR -->
        <!-- ========================= -->

        <Border Grid.Column="0"
                Background="#252526">

            <Grid Margin="20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>

                    <TextBlock Text="IT ASSET"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"/>

                    <TextBlock Text="MANAGER"
                               Foreground="#007ACC"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,30"/>

                    <TextBlock Text="Dashboard"
                               Foreground="White"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,0,0,15"/>

                    <Button Content="Import Excel"
                            Height="38"
                            Margin="0,0,0,10"
                            Background="#333337"
                            Foreground="White"
                            BorderThickness="0"
                            Click="ImportExcel_Click"/>

                    <Button Content="Export Excel"
                            Height="38"
                            Margin="0,0,0,10"
                            Background="#333337"
                            Foreground="White"
                            BorderThickness="0"
                            Click="ExportExcel_Click"/>

                    <Button Content="Audit Log"
                            Height="38"
                            Background="#333337"
                            Foreground="White"
                            BorderThickness="0"
                            Click="AuditLog_Click"/>

                </StackPanel>

                <StackPanel Grid.Row="2">

                    <TextBlock Text="Shortcuts"
                               Foreground="#888888"
                               FontSize="12"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Ctrl + F    Search"
                               Foreground="#777777"
                               FontSize="11"/>

                    <TextBlock Text="Ctrl + N    New device"
                               Foreground="#777777"
                               FontSize="11"/>

                    <TextBlock Text="Ctrl + Shift + C    Copy serial"
                               Foreground="#777777"
                               FontSize="11"
                               Margin="0,2,0,0"/>

                    <TextBlock Text="Enter    Open details"
                               Foreground="#777777"
                               FontSize="11"
                               Margin="0,2,0,0"/>

                    <TextBlock Text="Delete    Delete device"
                               Foreground="#777777"
                               FontSize="11"
                               Margin="0,2,0,0"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ========================= -->
        <!-- MAIN CONTENT -->
        <!-- ========================= -->

        <Grid Grid.Column="1"
              Margin="25">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- HEADER -->

            <Grid Grid.Row="0"
                  Margin="0,0,0,20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="Dashboard"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold"/>

                    <TextBlock Text="IT asset inventory"
                               Foreground="#888888"
                               FontSize="13"
                               Margin="0,3,0,0"/>

                </StackPanel>

                <Button Grid.Column="1"
                        Content="+ Add Device"
                        Width="130"
                        Height="38"
                        Background="#007ACC"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Command="{Binding AddDeviceCommand}"/>

            </Grid>


            <!-- SEARCH + FILTERS -->

            <Grid Grid.Row="1"
                  Margin="0,0,0,20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox"
                         Grid.Column="0"
                         Height="38"
                         Padding="10"
                         Margin="0,0,10,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search Manufacturer, Model, Serial, User or Status"/>

                <ComboBox Grid.Column="1"
                          Height="38"
                          Margin="0,0,10,0"
                          SelectedItem="{Binding SelectedStatus}"
                          ItemsSource="{Binding StatusFilters}"
                          ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}"/>

                <ComboBox Grid.Column="2"
                          Height="38"
                          Margin="0,0,10,0"
                          SelectedItem="{Binding SelectedAssignment}"
                          ItemsSource="{Binding AssignmentFilters}"
                          ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}"/>

                <Button Grid.Column="3"
                        Content="Clear"
                        Height="38"
                        Background="#333337"
                        Foreground="White"
                        BorderThickness="0"
                        Command="{Binding ClearFiltersCommand}"/>

            </Grid>


            <!-- STATISTICS -->

            <Grid Grid.Row="2"
                  Margin="0,0,0,20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- Total -->

                <Border Grid.Column="0"
                        Background="#252526"
                        CornerRadius="6"
                        Padding="15"
                        Margin="0,0,8,0">

                    <StackPanel>

                        <TextBlock Text="Total Devices"
                                   Foreground="#999999"
                                   FontSize="12"/>

                        <TextBlock Text="{Binding TotalDevices}"
                                   Foreground="White"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                </Border>


                <!-- In Stock -->

                <Border Grid.Column="1"
                        Background="#252526"
                        CornerRadius="6"
                        Padding="15"
                        Margin="0,0,8,0">

                    <StackPanel>

                        <TextBlock Text="In Stock"
                                   Foreground="#999999"
                                   FontSize="12"/>

                        <TextBlock Text="{Binding InStock}"
                                   Foreground="White"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                </Border>


                <!-- Issued -->

                <Border Grid.Column="2"
                        Background="#252526"
                        CornerRadius="6"
                        Padding="15"
                        Margin="0,0,8,0">

                    <StackPanel>

                        <TextBlock Text="Issued"
                                   Foreground="#999999"
                                   FontSize="12"/>

                        <TextBlock Text="{Binding Issued}"
                                   Foreground="White"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                </Border>


                <!-- Service -->

                <Border Grid.Column="3"
                        Background="#252526"
                        CornerRadius="6"
                        Padding="15"
                        Margin="0,0,8,0">

                    <StackPanel>

                        <TextBlock Text="Service"
                                   Foreground="#999999"
                                   FontSize="12"/>

                        <TextBlock Text="{Binding Service}"
                                   Foreground="White"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                </Border>


                <!-- Attention -->

                <Border Grid.Column="4"
                        Background="#252526"
                        CornerRadius="6"
                        Padding="15">

                    <StackPanel>

                        <TextBlock Text="Attention"
                                   Foreground="#999999"
                                   FontSize="12"/>

                        <TextBlock Text="{Binding WarningCount}"
                                   Foreground="#FFB000"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Margin="0,5,0,0"/>

                        <TextBlock Text="devices"
                                   Foreground="#777777"
                                   FontSize="11"/>

                    </StackPanel>

                </Border>

            </Grid>


            <!-- LOWER CONTENT -->

            <Grid Grid.Row="3">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>


                <!-- ========================= -->
                <!-- ASSET GRID -->
                <!-- ========================= -->

                <Border Grid.Column="0"
                        Background="#252526"
                        CornerRadius="6"
                        Padding="10"
                        Margin="0,0,15,0">

                    <DataGrid x:Name="AssetsGrid"
          ItemsSource="{Binding Assets}"
          AutoGenerateColumns="False"
          SelectionMode="Extended"
          SelectionUnit="FullRow"
          CanUserAddRows="False"
          IsReadOnly="True"
          HeadersVisibility="Column"
          GridLinesVisibility="Horizontal"
          Background="#252526"
          Foreground="White"
          BorderThickness="0"
          RowBackground="#252526"
          AlternatingRowBackground="#2D2D30"
          MouseDoubleClick="AssetsGrid_MouseDoubleClick">

                        <DataGrid.Resources>

                            <!-- Cellák -->
                            <Style TargetType="DataGridCell">

                                <Setter Property="Background"
                    Value="#252526"/>

                                <Setter Property="Foreground"
                    Value="#FFFFFF"/>

                                <Setter Property="BorderThickness"
                    Value="0"/>

                                <Setter Property="Padding"
                    Value="8,5"/>

                                <Style.Triggers>

                                    <!-- Egérrel rámutatva -->
                                    <Trigger Property="IsMouseOver"
                         Value="True">

                                        <Setter Property="Background"
                            Value="#3A3A3A"/>

                                        <Setter Property="Foreground"
                            Value="White"/>

                                    </Trigger>

                                    <!-- Kijelölt sor -->
                                    <Trigger Property="IsSelected"
                         Value="True">

                                        <Setter Property="Background"
                            Value="#007ACC"/>

                                        <Setter Property="Foreground"
                            Value="White"/>

                                    </Trigger>

                                </Style.Triggers>

                            </Style>


                            <!-- Sorok -->
                            <Style TargetType="DataGridRow">

                                <Setter Property="Background"
                    Value="#252526"/>

                                <Setter Property="Foreground"
                    Value="White"/>

                                <Style.Triggers>

                                    <Trigger Property="IsMouseOver"
                         Value="True">

                                        <Setter Property="Background"
                            Value="#333337"/>

                                        <Setter Property="Foreground"
                            Value="White"/>

                                    </Trigger>

                                    <Trigger Property="IsSelected"
                         Value="True">

                                        <Setter Property="Background"
                            Value="#007ACC"/>

                                        <Setter Property="Foreground"
                            Value="White"/>

                                    </Trigger>

                                </Style.Triggers>

                            </Style>


                            <!-- Fejléc -->
                            <Style TargetType="DataGridColumnHeader">

                                <Setter Property="Background"
                    Value="#333337"/>

                                <Setter Property="Foreground"
                    Value="#CCCCCC"/>

                                <Setter Property="FontWeight"
                    Value="SemiBold"/>

                                <Setter Property="Padding"
                    Value="8,7"/>

                                <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

                                <Setter Property="BorderBrush"
                    Value="#444444"/>

                            </Style>

                        </DataGrid.Resources>


                        <DataGrid.ContextMenu>

                            <ContextMenu>

                                <MenuItem Header="Edit Device"
                      Command="{Binding PlacementTarget.DataContext.EditDeviceCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem,
                                           RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                                <MenuItem Header="Delete Device"
                      Command="{Binding PlacementTarget.DataContext.DeleteDeviceCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem,
                                           RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                                <Separator/>

                                <MenuItem Header="Change Status"
                      Click="ChangeStatus_Click"/>

                                <MenuItem Header="Assign User"
                      Click="AssignUser_Click"/>

                            </ContextMenu>

                        </DataGrid.ContextMenu>


                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Inv ID"
                        Binding="{Binding InventoryId}"
                        Width="90"/>

                            <DataGridTextColumn Header="Manufacturer"
                        Binding="{Binding Manufacturer}"
                        Width="120"/>

                            <DataGridTextColumn Header="Model"
                        Binding="{Binding Model}"
                        Width="140"/>

                            <DataGridTextColumn Header="Serial"
                        Binding="{Binding SerialNumber}"
                        Width="140"/>

                            <DataGridTextColumn Header="Location"
                        Binding="{Binding Location}"
                        Width="120"/>

                            <DataGridTextColumn Header="Department"
                        Binding="{Binding Department}"
                        Width="120"/>

                            <DataGridTextColumn Header="Status"
                        Binding="{Binding Status}"
                        Width="90"/>

                            <DataGridTextColumn Header="Assigned User"
                        Binding="{Binding AssignedUser}"
                        Width="140"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Border>


                <!-- ========================= -->
                <!-- ATTENTION PANEL -->
                <!-- ========================= -->

                <Border Grid.Column="1"
                        Background="#252526"
                        CornerRadius="6"
                        Padding="15">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <!-- Header -->

                        <Grid Grid.Row="0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Attention"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="Bold"/>

                            <Border Grid.Column="1"
                                    Background="#6B5B00"
                                    CornerRadius="10"
                                    Padding="8,3">

                                <TextBlock Text="{Binding TotalWarnings}"
                                           Foreground="White"
                                           FontSize="11"
                                           FontWeight="Bold"/>

                            </Border>

                        </Grid>


                        <TextBlock Grid.Row="1"
                                   Text="Eszközök, amelyek figyelmet igényelnek"
                                   Foreground="#888888"
                                   FontSize="11"
                                   Margin="0,4,0,0"/>


                        <!-- Warning list -->

                        <ScrollViewer Grid.Row="3"
                                      VerticalScrollBarVisibility="Auto">

                            <ItemsControl ItemsSource="{Binding Warnings}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Border Background="#1E1E1E"
            CornerRadius="5"
            Padding="10"
            Margin="0,0,0,8"
            Cursor="Hand"
            MouseLeftButtonDown="Warning_MouseLeftButtonDown">

                                            <Grid>

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>


                                                <!-- Warning type -->

                                                <Grid Grid.Row="0">

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding WarningType}"
                                                               Foreground="White"
                                                               FontWeight="SemiBold"
                                                               FontSize="12"/>

                                                    <Border Grid.Column="1"
                                                            Style="{StaticResource WarningBadgeStyle}"
                                                            CornerRadius="8"
                                                            Padding="6,2">

                                                        <TextBlock Text="{Binding Severity}"
                                                                   Foreground="White"
                                                                   FontSize="9"
                                                                   FontWeight="Bold"/>

                                                    </Border>

                                                </Grid>


                                                <!-- Description -->

                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Message}"
                                                           Foreground="#AAAAAA"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Margin="0,5,0,0"/>

                                            </Grid>

                                        </Border>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </ScrollViewer>

                    </Grid>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</Window>